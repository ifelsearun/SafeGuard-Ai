# Dependencies are restored from package manifests and lock files.
node_modules/
.npm-cache/

# Build output is generated during development and deployment.
dist/
coverage/

# Local environment files can contain API keys and must never be committed.
.env
.env.*
!.env.example

# Runtime logs and diagnostic files.
*.log
logs/

# Operating system and editor-specific files.
.DS_Store
Thumbs.db
.vscode/
.idea/
